{
  "name": "synap-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Synap second-brain backend: Google Sign-In, Gemini AI Studio pipeline, CMEK-enveloped memory on GCP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/index.js",
    "test": "npm run build && node --env-file-if-exists=test/test.env --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/kms": "^4.5.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/tasks": "^5.5.0",
    "@google-cloud/firestore": "^7.11.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
